---
import { site } from "../data/site";
---

<section
  class="usage-section spec-section"
  aria-labelledby="usage-title"
  data-token-usage
  data-data-url={site.usage.dataUrl}
>
  <div class="section-heading">
    <p class="section-index">03</p>
    <h2 id="usage-title">Token usage</h2>
  </div>

  <div data-usage-body hidden></div>
  <p
    class="usage-state usage-unavailable"
    data-usage-state
    role="status"
    hidden
  >
    Loading live token usage...
  </p>
  <noscript>
    <p class="usage-unavailable">
      Live token usage requires JavaScript. Check the public data endpoint
      directly if you want the latest export.
    </p>
  </noscript>
</section>
